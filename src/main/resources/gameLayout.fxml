<?import com.comp2042.view.GameOverPanel?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<Pane fx:id="rootPane" fx:controller="com.comp2042.controllers.GuiController"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="root">

    <!-- Title and Score Header -->
    <HBox fx:id="headerArea" styleClass="header-area" alignment="CENTER" spacing="20" prefHeight="60">
        <Label text="TetrisJFX" styleClass="game-title"/>
        <VBox alignment="CENTER_RIGHT" styleClass="score-container">
            <Label text="SCORE" styleClass="score-label"/>
            <Label fx:id="scoreValue" text="0" styleClass="score-value"/>
            <Label fx:id="progressLabel" text="" styleClass="score-label"/>
        </VBox>
    </HBox>

    <!-- Game board (background) -->
    <BorderPane styleClass="gameBoard" fx:id="gameBoard" prefWidth="200" prefHeight="400">
        <center>
            <GridPane fx:id="gamePanel" hgap="1" vgap="1"/>
        </center>
    </BorderPane>

    <!-- Hold panel -->
    <VBox fx:id="heldBrickBox" spacing="5" styleClass="nextBrick" prefWidth="100" prefHeight="120">
        <Label text="HOLD" styleClass="nextBrickLabel"/>
        <GridPane fx:id="holdBrickPanel" vgap="1" hgap="1" prefWidth="80" prefHeight="80"/>
    </VBox>

    <!-- Next pieces panel -->
    <VBox fx:id="nextBricksBox" spacing="10" styleClass="nextBrick" prefWidth="100" prefHeight="120">
        <Label text="NEXT" styleClass="nextBrickLabel"/>
        <VBox fx:id="nextBricksPanel" spacing="8" prefWidth="80"/>
    </VBox>

    <!-- Footer with controls -->
    <VBox fx:id="footerArea" styleClass="footer-area" alignment="CENTER" spacing="8" prefHeight="80">
        <Label text="CONTROLS" styleClass="controls-title"/>
        <HBox styleClass="controls-container" spacing="12" alignment="CENTER">
            <VBox alignment="CENTER" spacing="2">
                <Label text="← →" styleClass="control-key"/>
                <Label text="MOVE" styleClass="control-description"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2">
                <Label text="Z/↑" styleClass="control-key"/>
                <Label text="ROTATE" styleClass="control-description"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2">
                <Label text="↓" styleClass="control-key"/>
                <Label text="SOFT DROP" styleClass="control-description"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2">
                <Label text="SPACE" styleClass="control-key"/>
                <Label text="HARD DROP" styleClass="control-description"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2">
                <Label text="C" styleClass="control-key"/>
                <Label text="HOLD" styleClass="control-description"/>
            </VBox>
            <VBox alignment="CENTER" spacing="2">
                <Label text="N" styleClass="control-key"/>
                <Label text="NEW GAME" styleClass="control-description"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Brick panel (On Top of GamePanel) -->
    <GridPane fx:id="brickPanel" vgap="1" hgap="1"/>

    <!-- Notifications (Most Top) -->
    <Group fx:id="groupNotification">
        <VBox alignment="CENTER">
            <GameOverPanel fx:id="gameOverPanel"/>
        </VBox>
    </Group>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</Pane>